{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run db:check)",
      "Bash(go test:*)",
      "Bash(golangci-lint run:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git worktree list:*)",
      "Bash(git commit:*)",
      "Bash(git push origin dev)",
      "Bash(.claude/skills/dev-diff/dev-diff.sh)",
      "Bash(.claude/skills/dev-diff/dev-diff.sh --list)",
      "Bash(.claude/scripts/gh-rest.sh:*)",
      "Bash(.claude/scripts/issue-status.sh:*)",
      "Bash(.claude/scripts/epic-status.sh:*)",
      "Bash(.claude/scripts/issue-readiness.sh:*)",
      "Bash(.claude/scripts/security-history.sh:*)",
      "Bash(.claude/skills/dev-diff/dev-diff.sh:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git add -A:*)",
      "Bash(git add --all:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git add .)"
    ],
    "additionalDirectories": [
      "../release-ops-cloud"
    ]
  }
}
