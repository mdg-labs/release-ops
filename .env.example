# Copy to .env and replace placeholder values before `docker compose up`.
# The server refuses to start with the placeholder SESSION_SECRET or APP_ENCRYPTION_KEY below.
# Full reference: docs/specs.html#env

# Required — session cookie signing (32+ random bytes).
# Generate: openssl rand -base64 32
SESSION_SECRET=change-me-use-openssl-rand-base64-32-at-least-32-chars

# Required — AES-256 credential encryption key (64 hexadecimal characters = 32 bytes).
# Generate: openssl rand -hex 32
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Optional — public URL for Secure cookies when using HTTPS
# APP_PUBLIC_URL=https://release-ops.example.com

# Optional — reverse proxies in front of the container (comma-separated IPs or CIDR ranges).
# Unset: the TCP peer is the client, which is right when port 3000 is reached directly. Set
# it when a reverse proxy terminates TLS in front of the container: the rate limits then key
# on the right-most X-Forwarded-For hop outside this list, read only when the peer is in it.
# A malformed value stops the container at startup.
# TRUSTED_PROXIES=172.18.0.0/16

# Optional — IANA timezone for UI timestamps (default UTC; API storage stays UTC)
# APP_TIMEZONE=Europe/Vienna

# Optional — one-time first-start admin (remove after first boot)
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=change-me

# Optional — SMTP for invitation, password-reset, and email-change emails
# When SMTP_HOST is unset, copy-link flows still work; send-email API returns 503.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=release-ops@example.com
# SMTP_TLS=true

# Optional until the worker ships — the internal listener the release-ops worker connects to.
# INTERNAL_ADDR is the app's bind address on the container network (never publish the port);
# WORKER_SECRET authenticates the worker to it (32+ random bytes, the same value on the worker)
# and is required together with INTERNAL_ADDR. Generate: openssl rand -base64 32
# INTERNAL_ADDR=:9090
# WORKER_SECRET=

# The worker container (`release-ops worker`) reads only these two variables, no app secret:
# INTERNAL_URL is the URL of the app's internal listener as the worker reaches it.
# INTERNAL_URL=http://release-ops:9090
