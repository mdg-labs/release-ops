# Copy to .env and replace placeholder values before `docker compose up`.
# Full reference: docs/specs.html#env

# Required — session cookie signing (32+ random bytes).
# Generate: openssl rand -base64 32
SESSION_SECRET=change-me-use-openssl-rand-base64-32-at-least-32-chars

# Required — AES-256 credential encryption key (64 hexadecimal characters = 32 bytes).
# Generate: openssl rand -hex 32
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Optional — public URL for Secure cookies when using HTTPS
# APP_PUBLIC_URL=https://release-ops.example.com

# Optional — one-time first-start admin (remove after first boot)
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=change-me

# Optional — SMTP for invitation, password-reset, and email-change emails
# When SMTP_HOST is unset, copy-link flows still work; send-email API returns 503.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=release-ops@example.com
# SMTP_TLS=true
